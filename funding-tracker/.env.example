# ---- Supabase ----
# Project URL: Project Settings -> Data API (always https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project Settings -> API Keys -> "Publishable key" (sb_publishable_...). The legacy "anon" JWT also works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Project Settings -> API Keys -> "Secret keys" -> create one (sb_secret_...). The legacy "service_role" JWT also works.
# Server-only. Never expose to the browser. Used for the Google Sheets mirror.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ---- App ----
# Only emails on this domain may sign in.
ALLOWED_EMAIL_DOMAIN=yale.edu
# Public URL of the deployed app (used for OAuth redirects). http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Anthropic (column-mapping suggestions). Optional: falls back to keyword heuristics if unset. ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Google Sheets mirror (optional). Service account must have Editor access to the sheet. ----
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service-account JSON, keeping the \n escapes.
GOOGLE_PRIVATE_KEY=
